{
  "name": "php2shell-detector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first Chrome extension for evidence-based PHP2Shell (CVE-2026-109618 / CVE-2026-109619) exposure assessment.",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "build:e2e": "vite build --mode e2e",
    "test:e2e": "npm run build:e2e && playwright test",
    "screenshots": "npm run build:e2e && node scripts/screenshots.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.1.11",
    "@radix-ui/react-tabs": "1.1.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/chrome": "0.1.4",
    "@types/node": "22.17.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "3.2.4"
  },
  "license": "MIT"
}
